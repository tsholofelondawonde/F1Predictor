{
  "//": "Optional. Copy to .claude/settings.json. These hooks keep the graphify knowledge graph honest by nudging searches through it first; they require the `graphify` CLI on your PATH and are harmless no-ops without it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [{ "type": "command", "command": "graphify hook-guard search" }]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [{ "type": "command", "command": "graphify hook-guard read" }]
      }
    ]
  }
}
