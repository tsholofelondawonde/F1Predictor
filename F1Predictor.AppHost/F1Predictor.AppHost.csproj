<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>eaa863b2-b133-46c8-81c1-214a1f390c49</UserSecretsId>
    <!-- ASPIRE010: Aspire 13.6 warns that AspireUseCliBundle defaults to false. We deliberately stay on the
         NuGet-delivered dashboard/DCP packages rather than switching to the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\F1Predictor.WebApi\F1Predictor.WebApi.csproj" />
  </ItemGroup>

</Project>
