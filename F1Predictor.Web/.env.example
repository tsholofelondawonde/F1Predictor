NEXT_PUBLIC_API_URL=http://localhost:5286
# Public origin of this site — used for metadataBase (absolute OG image/share URLs).
# Production deploys must override this to the real public origin, never localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must match Security:ApiKey on the backend (see SECURITY.md). Sent as X-Api-Key on
# every API request — a low bar, not real access control, since it ships in this public
# bundle. It only filters out naive automated hits against the raw API.
NEXT_PUBLIC_API_KEY=
