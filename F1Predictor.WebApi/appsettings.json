{
  "Database": {
    "Provider": "PostgreSql"
  },
  "OpenF1": {
    "BaseAddress": "https://api.openf1.org/v1/",
    "RequestDelayMilliseconds": 500,
    "TimeoutSeconds": 30
  },
  "MachineLearning": {
    "ModelDirectory": "models"
  },
  "IngestionScheduler": {
    "Enabled": true,
    "PostSessionBufferMinutes": 180,
    "CoordinatorIntervalMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*"
}
