{
  "Database": {
    "Provider": "PostgreSql"
  },
  "OpenF1": {
    "BaseAddress": "https://api.openf1.org/v1/",
    "RequestDelayMilliseconds": 500,
    "TimeoutSeconds": 30
  },
  "MachineLearning": {
    "ModelDirectory": "models"
  },
  "Security": {
    "ApiKey": ""
  },
  "Ai": {
    "Provider": "None",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "llama3.1:8b",
      "ContextLength": 16384
    },
    "OpenAi": {
      "Endpoint": "",
      "ApiKey": "",
      "ChatModel": "gpt-5-mini"
    },
    "Embeddings": {
      "Provider": "None",
      "Model": "text-embedding-3-small",
      "Dimensions": 1536
    },
    "TimeoutSeconds": 120,
    "MaxToolIterations": 6,
    "MaxOutputTokens": 800,
    "Temperature": 0.2,
    "DailyChatRequestCap": 500
  },
  "IngestionScheduler": {
    "Enabled": true,
    "PostSessionBufferMinutes": 180,
    "CoordinatorIntervalMinutes": 30
  },
  "AnalysisRefresh": {
    "Enabled": true,
    "IntervalMinutes": 360
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*"
}
